# Set default behavior to automatically normalize line endings to LF across all platforms
* text=auto eol=lf

# Explicit text files with LF line endings and language-specific diff drivers
*.py text eol=lf diff=python
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf diff=html
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.scss text eol=lf diff=css
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf diff=markdown
*.csv text eol=lf
*.sql text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf

# Binary file formats (prevent line ending conversion and textual diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.tar.gz binary
*.zip binary

# GitHub Linguist overrides
docs/* linguist-documentation
backend/tests/* linguist-test
frontend/tests/* linguist-test
